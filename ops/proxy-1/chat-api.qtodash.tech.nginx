# /etc/nginx/sites-available/chat-api.qtodash.tech
# Reverse proxy that fronts Groq with a server-held API key.
# The browser never sees the key.

# HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name chat-api.qtodash.tech;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name chat-api.qtodash.tech;

    ssl_certificate     /etc/letsencrypt/live/chat-api.qtodash.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat-api.qtodash.tech/privkey.pem;

    # Load upstream auth + voice-clone identifier from root-readable
    # includes. NOTE: these files live in /etc/nginx/snippets/, NOT
    # /etc/nginx/conf.d/ — files there are loaded at http{} scope where
    # the `set` directive is invalid.
    # /etc/nginx/snippets/groq-key.conf:
    #   set $groq_auth "Bearer gsk_NEWKEY";
    # /etc/nginx/snippets/elevenlabs-key.conf:
    #   set $elevenlabs_key "sk_…";
    #   set $elevenlabs_voice_id "<20-char voice id>";
    include /etc/nginx/snippets/groq-key.conf;
    include /etc/nginx/snippets/elevenlabs-key.conf;

    # ─── CORS allow-list (computed at server scope) ──────────
    set $allow_origin "";
    if ($http_origin = "https://include07.github.io") { set $allow_origin $http_origin; }
    if ($http_origin = "http://localhost:5173")       { set $allow_origin $http_origin; }

    # ─── Groq proxy ───────────────────────────────────────────
    location = /v1/chat/completions {
        if ($allow_origin = "") { return 403; }

        # Preflight (inside location: add_header here is legal)
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  $allow_origin always;
            add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type" always;
            add_header Access-Control-Max-Age       86400 always;
            add_header Content-Length 0 always;
            add_header Content-Type   "text/plain" always;
            return 204;
        }

        if ($request_method != POST) { return 405; }

        # Rate limit per IP — 1 r/s sustained, burst of 5.
        limit_req zone=chat_api burst=5 nodelay;
        limit_req_status 429;

        # Streaming SSE: don't buffer, don't compress.
        proxy_buffering    off;
        proxy_cache        off;
        gzip               off;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_read_timeout 120s;

        # Replace any client-supplied auth with ours.
        proxy_set_header Authorization  $groq_auth;
        proxy_set_header Content-Type   "application/json";
        proxy_set_header Host           "api.groq.com";

        # Strip headers that could leak origin info upstream.
        proxy_set_header Origin   "";
        proxy_set_header Referer  "";
        proxy_set_header X-Real-IP        $remote_addr;
        proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;

        # Upstream TLS / SNI — Cloudflare-fronted hosts reject handshakes
        # without SNI, manifesting as a 502 here.
        proxy_ssl_server_name on;
        proxy_ssl_name        api.groq.com;
        proxy_ssl_protocols   TLSv1.2 TLSv1.3;
        resolver              1.1.1.1 8.8.8.8 valid=300s;
        resolver_timeout      5s;

        proxy_pass https://api.groq.com/openai/v1/chat/completions;

        add_header Access-Control-Allow-Origin $allow_origin always;
        add_header Vary "Origin" always;
    }

    # NOTE: Web3Forms /form/submit relay was removed — their free tier
    # rejects server-side calls (`Pro plan is required` from server IP).
    # The browser now calls api.web3forms.com directly; Web3Forms's own
    # domain whitelist (include07.github.io) is the abuse control.

    # ─── Whisper transcription proxy ────────────────────────
    # Multipart/form-data upload of an audio blob; returns JSON {text:"…"}.
    location = /v1/audio/transcriptions {
        if ($allow_origin = "") { return 403; }

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  $allow_origin always;
            add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type" always;
            add_header Access-Control-Max-Age       86400 always;
            add_header Content-Length 0 always;
            add_header Content-Type   "text/plain" always;
            return 204;
        }

        if ($request_method != POST) { return 405; }

        # Audio uploads need more than the default 64k body limit.
        # Whisper accepts up to 25 MB; 10 MB is plenty for short clips.
        client_max_body_size  10m;
        client_body_buffer_size 1m;

        # Slightly tighter rate limit — transcription is per-utterance,
        # not per-keystroke. Burst lets a quick re-attempt through.
        limit_req zone=chat_api burst=3 nodelay;
        limit_req_status 429;

        # Buffer the multipart request body so NGINX can set Content-Length
        # upstream (Groq's API needs it).
        proxy_request_buffering on;
        proxy_buffering    off;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_read_timeout 60s;

        # Inject auth, preserve client's multipart Content-Type as-is.
        proxy_set_header Authorization $groq_auth;
        proxy_set_header Host          "api.groq.com";
        proxy_set_header Origin        "";
        proxy_set_header Referer       "";
        proxy_set_header X-Real-IP        $remote_addr;
        proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;

        proxy_ssl_server_name on;
        proxy_ssl_name        api.groq.com;
        proxy_ssl_protocols   TLSv1.2 TLSv1.3;
        resolver              1.1.1.1 8.8.8.8 valid=300s;
        resolver_timeout      5s;

        proxy_pass https://api.groq.com/openai/v1/audio/transcriptions;

        add_header Access-Control-Allow-Origin $allow_origin always;
        add_header Vary "Origin" always;
    }

    # ─── ElevenLabs TTS proxy (voice clone) ─────────────────
    # Browser POSTs JSON {text, model_id, voice_settings}. We inject
    # the API key and the voice_id (in the URL path) server-side, so
    # the bundle never sees them. Returns an MP3 stream — keep
    # proxy_buffering off so the audio bytes flow as they arrive.
    location = /v1/audio/speech {
        if ($allow_origin = "") { return 403; }

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  $allow_origin always;
            add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type" always;
            add_header Access-Control-Max-Age       86400 always;
            add_header Content-Length 0 always;
            add_header Content-Type   "text/plain" always;
            return 204;
        }

        if ($request_method != POST) { return 405; }

        # Text-only payload — keep request small so nobody can stuff
        # massive prompts and burn the quota in one shot.
        client_max_body_size  8k;
        client_body_buffer_size 8k;

        limit_req zone=chat_api burst=3 nodelay;
        limit_req_status 429;

        proxy_request_buffering on;
        proxy_buffering    off;          # stream MP3 back to browser
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_read_timeout 60s;

        # Auth + Accept; voice_id is in the URL via $elevenlabs_voice_id.
        proxy_set_header xi-api-key    $elevenlabs_key;
        proxy_set_header Content-Type  "application/json";
        proxy_set_header Accept        "audio/mpeg";
        proxy_set_header Host          "api.elevenlabs.io";
        proxy_set_header Origin        "";
        proxy_set_header Referer       "";
        proxy_set_header X-Real-IP        $remote_addr;
        proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;

        proxy_ssl_server_name on;
        proxy_ssl_name        api.elevenlabs.io;
        proxy_ssl_protocols   TLSv1.2 TLSv1.3;
        resolver              1.1.1.1 8.8.8.8 valid=300s;
        resolver_timeout      5s;

        proxy_pass https://api.elevenlabs.io/v1/text-to-speech/$elevenlabs_voice_id/stream;

        add_header Access-Control-Allow-Origin $allow_origin always;
        add_header Vary "Origin" always;
    }

    # Anything else → 404
    location / { return 404; }
}
